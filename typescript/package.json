{
	"name": "@barchart/binary-serializer-ts",
	"description": "Barchart Binary Serializer (TypeScript)",
	"version": "1.1.6",
	"author": {
		"name": "Luka Sotra",
		"email": "luka.sotra@barchart.com",
		"url": "https://www.barchart.com"
	},

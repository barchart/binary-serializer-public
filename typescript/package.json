		"LICENSE"
	],
	"main": "./dist/src/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": "./dist/src/index.js",
		"./dist": "./dist/src",
		"./dist/src/types/data_types": "./dist/src/types/data_types.js"
	},
	"dependencies": {
		"@barchart/common-js": "^5.5.0",
		"big.js": "^7.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/big.js": "^7.0.0",
		"@types/eslint__js": "^9.14.0",
		"@types/node": "^24.13.5",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^10.10.0",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"

		{
			"name": "Bryan",
			"email": "bryan.ingle@barchart.com"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/barchart/binary-serializer-public.git"
	},
	"scripts": {
		"clean": "rm -rf node_modules",
		"prebuild": "rm -rf dist",
		"build": "tsc --build tsconfig.build.json",
		"test": "vitest run",
		"lint": "yarn eslint 'src/**/*.ts' 'tests/**/*.ts'"
	},
	"files": [
		"dist/**/*",
